# =================================================================
# VARIABLES DE ENTORNO - BACKEND (Cuñadismo Ilustrado)
# Copia este archivo como .env y completa con tus valores reales
# =================================================================

# Configuración del servidor
NODE_ENV=development
PORT=3001

# Shipping Costs
SHIPPING_COST_SPAIN=6.99
SHIPPING_COST_EUROPA=12.99
FREE_SHIPPING_THRESHOLD=85

# Printify API (OBLIGATORIO - Obtener de https://printify.com/app/account/api)
PRINTIFY_API_KEY=tu_printify_api_key_aqui
PRINTIFY_SHOP_ID=tu_shop_id_numerico
PRINTIFY_WEBHOOK_SECRET=tu_printify_webhook_secret

# Stripe API (OBLIGATORIO - Obtener de https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_tu_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret

# URLs del frontend (actualizar según despliegue)
FRONTEND_URL=http://localhost:5174

# Configuración CORS
ALLOWED_ORIGINS=http://localhost:5173,https://tu-frontend-cunao.herokuapp.com

# Base de datos (si decides usar una en el futuro)
# DATABASE_URL=postgresql://usuario:password@host:puerto/basedatos

# Configuraciones de email (opcional para notificaciones)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=tu_email@gmail.com
# EMAIL_PASS=tu_app_password

# Configuraciones de seguridad
JWT_SECRET=tu_jwt_secret_muy_seguro_aqui

# Configuraciones de logging
LOG_LEVEL=info
LOG_FILE=logs/cunao-backend.log

# Configuraciones de cache (Redis si decides usarlo)
# REDIS_URL=redis://localhost:6379

# Cloudinary CDN (OBLIGATORIO para optimización de imágenes)
CLOUDINARY_CLOUD_NAME=tu_cloudinary_cloud_name
CLOUDINARY_API_KEY=tu_cloudinary_api_key  
CLOUDINARY_API_SECRET=tu_cloudinary_api_secret

# Configuraciones de Heroku
# HEROKU_APP_NAME=tu-backend-cunao

# Controla si los pedidos de Printify se envían a producción automáticamente
# 'true' para producción, 'false' para desarrollo/pruebas
PRINTIFY_AUTO_SUBMIT_TO_PRODUCTION=false