# Copy this file to .env and fill in your own values.
# Never commit a real .env file.

# --- Server ---
NODE_ENV=development
PORT=3001

# --- Database ---
MONGO_URI=mongodb://localhost:27017/cunao

# --- Auth & security ---
# Signs admin JWTs (cookie / Bearer / x-admin-token)
JWT_SECRET=<long-random-string>
# HMAC secret for newsletter preference/unsubscribe tokens
NEWSLETTER_SECRET=<long-random-string>
# Legacy key accepted by the review moderation endpoints (x-admin-key)
ADMIN_KEY=<random-string>
# Used once by scripts/createAdmin.ts to seed the first admin user
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASS=<strong-password>

# --- CORS, cookies and frontend URLs ---
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=
FRONTEND_URL=http://localhost:5173
FRONTEND_PRODUCTION_URL=https://shop.example.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# --- Printify ---
PRINTIFY_API_KEY=<printify-personal-access-token>
PRINTIFY_SHOP_ID=<printify-shop-id>
PRINTIFY_WEBHOOK_SECRET=<printify-webhook-secret>
# true = orders are sent to production automatically after payment
PRINTIFY_AUTO_SUBMIT_TO_PRODUCTION=false

# --- Cloudinary (either the three values below or CLOUDINARY_URL) ---
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
# CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>

# --- Email (Zoho SMTP, smtp.zoho.eu) ---
ZOHO_EMAIL_USER=noreply@example.com
ZOHO_APP_PASSWORD=<app-password>

# --- Google Analytics 4 Measurement Protocol ---
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_API_SECRET=<ga-api-secret>

# --- Shipping (EUR) ---
SHIPPING_COST_SPAIN=4.95
SHIPPING_COST_EUROPA=7.95
FREE_SHIPPING_THRESHOLD=55
