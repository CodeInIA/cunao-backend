# =================================================================
# Ejemplo de variables de entorno para el BACKEND
# Copia este archivo a `.env` y reemplaza los valores por los reales.
# NO comites tu `.env` con claves reales al repositorio.
# =================================================================

# Entorno y servidor
NODE_ENV=development
PORT=3001

# GA4 (ejemplo desde .env)
GA_MEASUREMENT_ID=G-B2YZBLFSS5
GA_API_SECRET=<GA_API_SECRET>

# Zoho / email (ejemplo)
ZOHO_EMAIL_USER=noreply@cunadismoilustrado.me
ZOHO_APP_PASSWORD=<ZOHO_APP_PASSWORD>

# MongoDB (valores reales en .env - aquí poner placeholder)
MONGO_URI=mongodb+srv://<USER>:<PASSWORD>@cluster0.mongodb.net/cunadismoilustrado

# Shipping Costs (ejemplo)
SHIPPING_COST_SPAIN=4.95
SHIPPING_COST_EUROPA=7.95
FREE_SHIPPING_THRESHOLD=55

# Printify (el valor real en .env es un token largo; aquí poner placeholder)
PRINTIFY_API_KEY=<PRINTIFY_API_KEY>
PRINTIFY_SHOP_ID=23849590
PRINTIFY_WEBHOOK_SECRET=<PRINTIFY_WEBHOOK_SECRET>

# Stripe (reemplaza por tus claves en producción)
STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>

# Cloudinary (ejemplo)
CLOUDINARY_CLOUD_NAME=cunadismocdn
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>

# URLs del frontend
FRONTEND_URL=http://localhost:5173
FRONTEND_PRODUCTION_URL=https://www.cunadismoilustrado.me

# Configuración CORS - en producción ajusta a tus orígenes exactos
ALLOWED_ORIGINS=http://localhost:5173,https://www.cunadismoilustrado.me

# Dominio para las cookies (usar .dominio.com para compartir entre subdominios)
COOKIE_DOMAIN=.cunadismoilustrado.me

# Seguridad / tokens
JWT_SECRET=<UNA_CLAVE_SECRETA_LARGA>

# Credenciales del admin inicial (opcional)
INIT_ADMIN_EMAIL=<ADMIN_EMAIL>
INIT_ADMIN_PASS=<ADMIN_PASS>

# Control de envío a Printify (true|false)
PRINTIFY_AUTO_SUBMIT_TO_PRODUCTION=false

